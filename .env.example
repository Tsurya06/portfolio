# Email Provider Configuration (Choose either Web3Forms or EmailJS)
# Both options are 100% free for static sites hosted on GitHub Pages.

# Option 1: Web3Forms (Recommended - easiest setup, no credit card, unlimited basic messages)
# Get your free access key instantly at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=

# Option 2: EmailJS (Free tier: 200 emails/month)
# Create a free account at https://www.emailjs.com
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
